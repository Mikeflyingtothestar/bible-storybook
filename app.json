{
  "expo": {
    "name": "Bible Storybook",
    "slug": "bible-storybook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "biblestorybook",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biblestorybook.app"
    },
    "android": {
      "package": "com.biblestorybook.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/bible-storybook"
    },
    "extra": {
      "supabaseUrl": "https://nkpnanqbiehoqgnpmlhh.supabase.co",
      "supabasePublishableKey": "sb_publishable_6CxUJnf_A4jMTrgevmALUA_J9AHj_SV"
    }
  }
}
